<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>InvokersRu.Cli</AssemblyName>
    <Version>3.1.5-preview</Version>
    <Company>Invokers Russian Community</Company>
    <Product>InvokersRu localization patcher</Product>
    <Description>Version-aware community localization tooling for Invokers: Titan Legacy.</Description>
    <EnableSupervisedInstallWrites Condition="'$(EnableSupervisedInstallWrites)' == ''">false</EnableSupervisedInstallWrites>
    <EnableOfflineCommunityRuntimeCacheWrites Condition="'$(EnableOfflineCommunityRuntimeCacheWrites)' == ''">false</EnableOfflineCommunityRuntimeCacheWrites>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableSupervisedInstallWrites)' == 'true'">
    <DefineConstants>$(DefineConstants);INVOKERSRU_SUPERVISED_WRITES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\InvokersRu.Core\InvokersRu.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableSupervisedInstallWrites)' == 'true' and '$(TrustedCompatibilityPath)' != ''">
    <EmbeddedResource Include="$(TrustedCompatibilityPath)" LogicalName="InvokersRu.TrustedCompatibility.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableSupervisedInstallWrites)' == 'true' and '$(TrustedRuntimeCacheCompatibilityPath)' != ''">
    <EmbeddedResource Include="$(TrustedRuntimeCacheCompatibilityPath)" LogicalName="InvokersRu.TrustedRuntimeCacheCompatibility.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(SignedUpdateChannelConfigPath)' != ''">
    <EmbeddedResource Include="$(SignedUpdateChannelConfigPath)" LogicalName="InvokersRu.SignedUpdateChannel.json" />
  </ItemGroup>
  <Target Name="ValidateSupervisedWriteBuild" BeforeTargets="CoreCompile" Condition="'$(EnableSupervisedInstallWrites)' == 'true'">
    <Error Condition="'$(TrustedCompatibilityPath)' == ''" Text="A supervised write build requires /p:TrustedCompatibilityPath=ABSOLUTE_PATH." />
    <Error Condition="'$(TrustedCompatibilityPath)' != '' and !$([System.IO.Path]::IsPathFullyQualified('$(TrustedCompatibilityPath)'))" Text="TrustedCompatibilityPath must be an absolute path: $(TrustedCompatibilityPath)" />
    <Error Condition="'$(TrustedCompatibilityPath)' != '' and !Exists('$(TrustedCompatibilityPath)')" Text="TrustedCompatibilityPath does not exist: $(TrustedCompatibilityPath)" />
    <Error Condition="'$(TrustedRuntimeCacheCompatibilityPath)' != '' and '$(SignedUpdateChannelConfigPath)' == '' and '$(EnableOfflineCommunityRuntimeCacheWrites)' != 'true'" Text="A runtime-cache write build requires /p:SignedUpdateChannelConfigPath=ABSOLUTE_PATH or the explicit offline community build mode." />
    <Error Condition="'$(EnableOfflineCommunityRuntimeCacheWrites)' == 'true' and ('$(TrustedRuntimeCacheCompatibilityPath)' == '' or '$(SignedUpdateChannelConfigPath)' != '')" Text="Offline community runtime-cache writes require an embedded profile and no signed-update channel." />
    <Error Condition="'$(TrustedRuntimeCacheCompatibilityPath)' != '' and '$(SignedUpdateChannelConfigPath)' != '' and !$([System.IO.Path]::IsPathFullyQualified('$(SignedUpdateChannelConfigPath)'))" Text="SignedUpdateChannelConfigPath must be an absolute path: $(SignedUpdateChannelConfigPath)" />
    <Error Condition="'$(TrustedRuntimeCacheCompatibilityPath)' != '' and '$(SignedUpdateChannelConfigPath)' != '' and !Exists('$(SignedUpdateChannelConfigPath)')" Text="SignedUpdateChannelConfigPath does not exist: $(SignedUpdateChannelConfigPath)" />
  </Target>
  <Target Name="ValidateOptionalRuntimeCacheWriteProfile" BeforeTargets="CoreCompile" Condition="'$(EnableSupervisedInstallWrites)' == 'true' and '$(TrustedRuntimeCacheCompatibilityPath)' != ''">
    <Error Condition="!$([System.IO.Path]::IsPathFullyQualified('$(TrustedRuntimeCacheCompatibilityPath)'))" Text="TrustedRuntimeCacheCompatibilityPath must be an absolute path: $(TrustedRuntimeCacheCompatibilityPath)" />
    <Error Condition="!Exists('$(TrustedRuntimeCacheCompatibilityPath)')" Text="TrustedRuntimeCacheCompatibilityPath does not exist: $(TrustedRuntimeCacheCompatibilityPath)" />
  </Target>
  <Target Name="ValidateOptionalSignedUpdateChannel" BeforeTargets="CoreCompile" Condition="'$(SignedUpdateChannelConfigPath)' != ''">
    <Error Condition="!$([System.IO.Path]::IsPathFullyQualified('$(SignedUpdateChannelConfigPath)'))" Text="SignedUpdateChannelConfigPath must be an absolute path: $(SignedUpdateChannelConfigPath)" />
    <Error Condition="!Exists('$(SignedUpdateChannelConfigPath)')" Text="SignedUpdateChannelConfigPath does not exist: $(SignedUpdateChannelConfigPath)" />
  </Target>
</Project>
